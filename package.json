{
  "name": "ai-engineer-coach-plus",
  "displayName": "AI Engineer Coach",
  "description": "Understand your codebase and how AI changed it. Archify knowledge graph, AI edit history with diffs, and coaching analytics for Claude Code, Codex, Copilot and more. Read-only until you opt in to Claude-powered features; zero telemetry.",
  "version": "2.1.0",
  "publisher": "ai-engineer-coach",
  "author": {
    "name": "Sanjay Singh, Joy Distelbrink, Tamas Boncz, Aymen Furter"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/AI-Engineering-Coach.git"
  },
  "bugs": {
    "url": "https://github.com/microsoft/AI-Engineering-Coach/issues"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "copilot",
    "analytics",
    "harness",
    "claude",
    "codex",
    "opencode",
    "productivity",
    "github",
    "archify",
    "knowledge-graph",
    "architecture",
    "history",
    "diff"
  ],
  "activationEvents": [
    "onCommand:aiEngineerCoach.open",
    "onCommand:aiEngineerCoach.reload",
    "onCommand:aiEngineerCoach.exportSummary",
    "onCommand:aiEngineerCoach.reviewLocalRules",
    "onCommand:aiEngineerCoach.showFileHistory",
    "onCommand:aiEngineerCoach.openAtlas",
    "onCommand:aiEngineerCoach.showFileInAtlas",
    "onWebviewPanel:aiEngineerCoach.atlasMap",
    "onView:aiEngineerCoach.welcome"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiEngineerCoach.open",
        "title": "AI Engineer Coach: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "aiEngineerCoach.reload",
        "title": "AI Engineer Coach: Reload Data",
        "icon": "$(refresh)"
      },
      {
        "command": "aiEngineerCoach.exportSummary",
        "title": "AI Engineer Coach: Export Summary",
        "icon": "$(export)"
      },
      {
        "command": "aiEngineerCoach.reviewLocalRules",
        "title": "AI Engineer Coach: Review Local Rule Approvals",
        "icon": "$(shield)"
      },
      {
        "command": "aiEngineerCoach.continueSession",
        "title": "AI Engineer Coach: Continue Claude Session",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiEngineerCoach.refreshSessions",
        "title": "AI Engineer Coach: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "aiEngineerCoach.showFileHistory",
        "title": "AI Engineer Coach: Show AI History for File",
        "icon": "$(history)"
      },
      {
        "command": "aiEngineerCoach.openAtlas",
        "title": "AI Engineer Coach: Open Atlas (codebase map)",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "aiEngineerCoach.showFileInAtlas",
        "title": "AI Engineer Coach: Show File in Atlas",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiEngineerCoach.refreshSessions",
          "when": "view == aiEngineerCoach.sessions",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "aiEngineerCoach.showFileHistory",
          "when": "config.aiEngineerCoach.replay.enabled && !explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "aiEngineerCoach.showFileInAtlas",
          "when": "config.aiEngineerCoach.atlas.enabled && !explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "aiEngineerCoach.showFileHistory",
          "when": "config.aiEngineerCoach.replay.enabled"
        },
        {
          "command": "aiEngineerCoach.showFileInAtlas",
          "when": "config.aiEngineerCoach.atlas.enabled"
        }
      ],
      "commandPalette": [
        {
          "command": "aiEngineerCoach.continueSession",
          "when": "config.aiEngineerCoach.sessionChat.enabled"
        },
        {
          "command": "aiEngineerCoach.refreshSessions",
          "when": "config.aiEngineerCoach.sessionChat.enabled"
        },
        {
          "command": "aiEngineerCoach.showFileHistory",
          "when": "config.aiEngineerCoach.replay.enabled"
        },
        {
          "command": "aiEngineerCoach.openAtlas",
          "when": "config.aiEngineerCoach.atlas.enabled"
        },
        {
          "command": "aiEngineerCoach.showFileInAtlas",
          "when": "config.aiEngineerCoach.atlas.enabled"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiEngineerCoach",
          "title": "AI Engineer Coach",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "aiEngineerCoach": [
        {
          "id": "aiEngineerCoach.welcome",
          "name": "Dashboard",
          "type": "webview"
        },
        {
          "id": "aiEngineerCoach.sessions",
          "name": "Sessions",
          "type": "tree",
          "when": "config.aiEngineerCoach.sessionChat.enabled"
        }
      ]
    },
    "configuration": {
      "title": "AI Engineer Coach",
      "properties": {
        "aiEngineerCoach.sessionChat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Session Chat (continue Claude Code sessions from the dashboard). This is a kill-switch; nothing spawns the Claude CLI until you accept the one-time Claude-powered features consent. Turns are appended to ~/.claude session history by the CLI and spend your Claude usage."
        },
        "aiEngineerCoach.sessionChat.binPath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude Code CLI binary used to continue sessions."
        },
        "aiEngineerCoach.sessionChat.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Per-turn timeout in milliseconds. Resumed sessions re-hydrate their full transcript, so long sessions need more headroom."
        },
        "aiEngineerCoach.sessionChat.model": {
          "type": "string",
          "default": "",
          "description": "Model passed to --model when continuing a session. Leave empty to inherit your Claude CLI configuration (recommended — resuming a cheap-model session under an Opus default silently multiplies per-turn cost)."
        },
        "aiEngineerCoach.sessionChat.permissionMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "plan",
            "acceptEdits"
          ],
          "enumDescriptions": [
            "Conversation only: no tools run (--allowedTools \"\"). Same posture as Phase 1.",
            "Claude may read files and plan, but cannot mutate them.",
            "File edits are auto-approved in the session's working directory. A persistent banner shows the cwd while this mode is active."
          ],
          "description": "Tool-execution posture for live Session Chat (Phase 2). 'none' keeps the extension's conversation-only default. 'acceptEdits' shows a persistent banner with the working directory."
        },
        "aiEngineerCoach.atlas.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Atlas: an Archify-generated, source-linked architecture map of the current workspace. Generating a map spawns the Claude CLI (after consent) and never happens without an explicit Generate click; maps are stored in extension storage, never in the repository."
        },
        "aiEngineerCoach.atlas.timeoutMs": {
          "type": "number",
          "default": 600000,
          "description": "Kill an Atlas generation run after this many milliseconds (default 10 minutes)."
        },
        "aiEngineerCoach.atlas.model": {
          "type": "string",
          "default": "",
          "description": "Model passed to --model for Atlas runs. Empty falls back to sessionChat.model, then the Claude CLI default. 'sonnet' is a good first choice: the spike mapped this repo for ~$0.50 vs ~$2 on Opus."
        },
        "aiEngineerCoach.atlas.maxMaps": {
          "type": "number",
          "default": 10,
          "description": "Maps kept per workspace; the oldest is pruned when a new one is saved."
        },
        "aiEngineerCoach.atlas.refineEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable map refinement (free-text instructions that update an existing map via --resume) and the Replay → Atlas session overlay. Each refinement is a deliberate click after a scope estimate."
        },
        "aiEngineerCoach.atlas.explainEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable 'Explain this session': a one-page Archify explainer of what a Replay session changed and why, with the session's diffs pinned as evidence."
        },
        "aiEngineerCoach.replay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Replay: read-only AI edit history with diffs reconstructed from local Claude Code session logs. Adds 'Show AI History for File' to the Explorer context menu. Replay never writes to disk except an explicit Export."
        },
        "aiEngineerCoach.replay.maxDiffBytes": {
          "type": "number",
          "default": 524288,
          "description": "Largest single edit payload (bytes) Replay will render inline. Bigger payloads show a note instead."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "aiEngineerCoach.aicoach",
        "fullName": "AI Engineering Coach",
        "name": "aicoach",
        "description": "Your AI coding coach — analyze usage patterns, get improvement tips, and track progress",
